<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Core 单目标 net10.0 —— 这是真正能跨平台的目标框架。
      平台专属文件（WindowsPlatform / ShellLink / ComRegistrar / PeIconPatcher）
      只用 Microsoft.Win32（.NET 10 内置跨平台 API 表层）+ P/Invoke，
      在 net10.0 下原样编译。只有 SandboxPlatform 依赖的注册表实现
      在非 Windows 上运行时会抛 PlatformNotSupportedException —— 那是运行时问题，
      编译期不受影响。安装器本身是 Windows 产品，但核心逻辑现在可以复用。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Installer.Core</RootNamespace>
    <AssemblyName>Installer.Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Installer.Abstractions\Installer.Abstractions.csproj" />
  </ItemGroup>

</Project>
