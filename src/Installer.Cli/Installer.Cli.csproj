<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net461</TargetFramework>
        <!--
      只钉平台，**不钉 RuntimeIdentifier**（原因见 Installer.Runtime.csproj 的同名注释：
      VS 的 NuGet restore 会因为 RID 报 "doesn't list 'win' as a RuntimeIdentifier"）。
    -->
    <PlatformTarget>x86</PlatformTarget>
    <!-- 别让输出多一层 win-x86\ —— e2e、文档、StubLocator 都按 bin\Debug\ 找 -->
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Installer.Cli</RootNamespace>
    <AssemblyName>installer-cli</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Installer.Core\Installer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
