<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Installer.Runtime</RootNamespace>
    <AssemblyName>Installer.Runtime</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Installer.Core\Installer.Core.csproj" />
    <ProjectReference Include="..\Installer.UI\Installer.UI.csproj" />
  </ItemGroup>

  <!--
    单文件 exe 的关键：把所有引用程序集嵌进自己的资源，运行时由
    EmbeddedAssemblyResolver 从资源里解出来。

    为什么放在 Target 里而不是 ItemGroup：
      EmbeddedResource 项在 ResolveReferences 之前求值，那会儿「兄弟项目
      刚编译出来的 dll」路径还没确定（并行构建更明显），直接写 Include
      要么解析不到、要么编出一个跑不起来的 exe。
      放到 AfterTargets="ResolveReferences" 就用 @(ReferencePath) ——
      那时引用已全部解析完，必定拿得到全部 DLL。
  -->

</Project>
