<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <!--
      测试项目要引用 Installer.UI / Installer.Builder（WizardPresenterTests 用的是
      Installer.UI.Presenters），而那两个项目是 net10.0-windows。
      跨平台项目（net10.0）无法引用 Windows 专用项目，所以测试项目本身也是
      net10.0-windows —— 它本来就只在 Windows 上跑（被测的桩是 .exe）。
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Installer.Core.Tests</RootNamespace>
    <AssemblyName>Installer.Core.Tests</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Installer.Core\Installer.Core.csproj" />
    <ProjectReference Include="..\..\src\Installer.UI\Installer.UI.csproj" />
    <ProjectReference Include="..\..\src\Installer.Builder\Installer.Builder.csproj" />
    <ProjectReference Include="..\..\src\Installer.Abstractions\Installer.Abstractions.csproj" />
  </ItemGroup>

</Project>
