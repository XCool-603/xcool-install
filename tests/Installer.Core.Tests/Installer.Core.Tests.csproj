<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      测试项目用 net462，产品用 net461：唯一的 xunit 测试运行器
      (xunit.runner.visualstudio 2.8.2) 最低只支持到 net462，
      net461 没有任何可用版本。测试项目不随产品发布，
      且 net462 能正常引用 net461 的程序集，所以不影响交付目标。
    -->
    <TargetFramework>net462</TargetFramework>
    <!--
      测试宿主必须和被测的 exe 项目同位数：它引用了 x86 的 Installer.Builder /
      Installer.Runtime，AnyCPU（64 位）宿主加载 x86 程序集会 BadImageFormatException。

      同样要显式写 RuntimeIdentifier —— 只写 PlatformTarget 的话 SDK 会自己推一个
      但 restore 不生成对应资产目标，build 报 NETSDK1047。
      详见 Installer.Runtime.csproj 的同名注释。
    -->
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!--
      ⚠️⚠️ 这一行是给 VS2017 用的，**删掉会导致 VS2017 打不开 / 构建不了本解决方案**：
            error NETSDK1050: 该项目使用的 Microsoft.NET.Sdk 版本过低，
            不支持对面向 .NET Standard 1.5 或更高版本的库的引用。
          位置：VS2017\MSBuild\Microsoft\Microsoft.NET.Build.Extensions\
                Microsoft.NET.Build.Extensions.NETFramework.targets(67,5)

      原因：本测试项目是 net462，而它引用的 xunit 2.9.3 / Microsoft.NET.Test.Sdk
      等包是 netstandard2.0 的。VS2017 自带的 .NET Core SDK 是 1.x，它**不会**
      设置 UsingMicrosoftNETSdk 属性，于是上面那个 targets 文件在第 65~67 行
      误判成「SDK 版本过低」并报错。

      但 VS2017 15.9 自带 net461/net462 的 netstandard2.0 支撑程序集
      （97 个 DLL，在 MSBuild\Microsoft\Microsoft.NET.Build.Extensions\net461\lib 下），
      完全够用。显式把这个属性设为 true 就能绕过误判。

      .NET Core SDK 2.0+ 会自己设置它，所以新环境下这一行无害
      （dotnet build / CI 照常工作）。

      复现方法（VS2017 的 MSBuild，不是 dotnet）：
        & "C:\Program Files (x86)\Microsoft Visual Studio\2017\Community\MSBuild\15.0\Bin\MSBuild.exe" `
            tests\Installer.Core.Tests\Installer.Core.Tests.csproj /t:Build /v:m
    -->
    <UsingMicrosoftNETSdk>true</UsingMicrosoftNETSdk>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Installer.Core.Tests</RootNamespace>
    <AssemblyName>Installer.Core.Tests</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- View 往返测试要直接构造 UserControl -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Installer.Core\Installer.Core.csproj" />
    <ProjectReference Include="..\..\src\Installer.UI\Installer.UI.csproj" />
    <ProjectReference Include="..\..\src\Installer.Builder\Installer.Builder.csproj" />
    <ProjectReference Include="..\..\src\Installer.Runtime\Installer.Runtime.csproj" />
  </ItemGroup>

</Project>
