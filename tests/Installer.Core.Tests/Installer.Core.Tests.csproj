<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      测试项目用 net462，产品用 net461：唯一的 xunit 测试运行器
      (xunit.runner.visualstudio 2.8.2) 最低只支持到 net462，
      net461 没有任何可用版本。测试项目不随产品发布，
      且 net462 能正常引用 net461 的程序集，所以不影响交付目标。
    -->
    <TargetFramework>net462</TargetFramework>
        <!--
      只钉平台，**不钉 RuntimeIdentifier**（原因见 Installer.Runtime.csproj 的同名注释：
      VS 的 NuGet restore 会因为 RID 报 "doesn't list 'win' as a RuntimeIdentifier"）。
    -->
    <!-- 测试宿主必须和被测的 exe 项目同位数：它引用了 x86 的 Installer.Builder，
         AnyCPU（64 位）宿主加载 x86 程序集会 BadImageFormatException。 -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Installer.Core.Tests</RootNamespace>
    <AssemblyName>Installer.Core.Tests</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Installer.Core\Installer.Core.csproj" />
    <ProjectReference Include="..\..\src\Installer.UI\Installer.UI.csproj" />
    <ProjectReference Include="..\..\src\Installer.Builder\Installer.Builder.csproj" />
    <ProjectReference Include="..\..\src\Installer.Runtime\Installer.Runtime.csproj" />
  </ItemGroup>

</Project>
